.auth.uid || isAdmin());\n      allow list: if isSignedIn() && (existing().reporterId == request.auth.uid || isAdmin());\n\n      allow create: if isValidId(reportId) && isActiveAccount() &&\n                       incoming().reporterId == request.auth.uid &&\n                       incoming().status == 'open' &&\n                       incoming().keys().hasAll([\n                         'reporterId', 'targetType', 'targetId', 'targetVideoId',\n                         'reason', 'details', 'status', 'createdAt', 'updatedAt'\n                       ]) &&\n                       incoming().keys().hasOnly([\n                         'reporterId', 'targetType', 'targetId', 'targetVideoId',\n                         'reason', 'details', 'status', 'createdAt', 'updatedAt'\n                       ]) &&\n                       isValidReport(incoming());\n\n      allow update: if isValidId(reportId) && isAdmin() &&\n                       isValidReport(incoming()) &&\n                       incoming().reporterId == existing().reporterId &&\n                       incoming().createdAt == existing().createdAt &&\n                       existing().status != 'resolved' &&\n                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);\n\n      allow delete: if isValidId(reportId) && isAdmin();\n    }\n\n    // 5. Platform Settings (Admin-controlled categories, banners, updates, external share link & ads)\n    match /platformSettings/{settingId} {\n      allow get: if isValidId(settingId) && isSignedIn();\n      allow list: if isSignedIn() && existing().featuredBannerText is string;\n      allow create, update: if isValidId(settingId) && isAdmin() &&\n                               incoming().keys().hasAll(['disabledCategories', 'featuredBannerText', 'maintenanceNotice', 'updatedAt']) &&\n                               incoming().keys().hasOnly([\n                                 'disabledCategories', 'featuredBannerText', 'maintenanceNotice',\n                                 'latestVersionCode', 'latestVersionName', 'updateUrl', 'updateNotes', 'forceUpdate',\n                                 'shareAppUrl', 'sharePromoText',\n                                 'adsEnabled', 'adPreRollEnabled', 'adMidRollEnabled', 'adPostRollEnabled',\n                                 'adSkipAfterSec', 'adDurationSec', 'adTitle', 'adDescription', 'adMediaUrl', 'adClickUrl',\n                                 'updatedAt'\n                               ]) &&\n                               isValidPlatformSettings(incoming());\n      allow delete: if isValidId(settingId) && isAdmin();\n    }\n\n    // 6. Admins Registry\n    match /admins/{adminUid} {\n      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isAdmin());\n      allow list: if isAdmin();\n      allow create, update, delete: if isValidId(adminUid) && isAdmin();\n    }\n\n    // 7. Creator Monetization Requests (500 subs + 1000 watch hrs OR 100K Shorts engaged views)\n    match /monetizationRequests/{creatorId} {\n      allow get: if isValidId(creatorId) && (isOwner(creatorId) || isAdmin());\n      allow list: if isAdmin();\n\n      allow create: if isValidId(creatorId) &&\n                       isOwner(creatorId) &&\n                       incoming().creatorId == request.auth.uid &&\n                       incoming().status == 'pending' &&\n                       incoming().displayName is string && incoming().displayName.size() >= 1 && incoming().displayName.size() <= 60 &&\n                       incoming().username is string && incoming().username.size() >= 3 && incoming().username.size() <= 30 &&\n                       incoming().followersCount is int && incoming().followersCount >= 500 &&\n                       incoming().watchTimeHours is int && incoming().watchTimeHours >= 0 &&\n                       incoming().shortsEngagementViews is int && incoming().shortsEngagementViews >= 0 &&\n                       (incoming().watchTimeHours >= 1000 || incoming().shortsEngagementViews >= 100000) &&\n                       incoming().payoutMethod in ['UPI', 'Bank Transfer'] &&\n                       get(/databases/$(database)/documents/creators/$(creatorId)).data.accountStatus == 'active' &&\n                       get(/databases/$(database)/documents/creators/$(creatorId)).data.followersCount >= 500 &&\n                       (\n                         (incoming().watchTimeHours >= 1000 && get(/databases/$(database)/documents/creators/$(creatorId)).data.totalWatchTimeSec >= 3600000) ||\n                         (incoming().shortsEngagementViews >= 100000 && (\n                           get(/databases/$(database)/documents/creators/$(creatorId)).data.totalViews >= 100000 ||\n                           ('totalEngagedViews' in get(/databases/$(database)/documents/creators/$(creatorId)).data &&\n                            get(/databases/$(database)/documents/creators/$(creatorId)).data.totalEngagedViews >= 100000)\n                         ))\n                       ) &&\n                       incoming().keys().hasAll([\n                         'creatorId', 'displayName', 'username', 'followersCount',\n                         'watchTimeHours', 'shortsEngagementViews', 'payoutMethod',\n                         'status', 'createdAt', 'updatedAt'\n                       ]) &&\n                       incoming().keys().hasOnly([\n                         'creatorId', 'displayName', 'username', 'followersCount',\n                         'watchTimeHours', 'shortsEngagementViews', 'payoutMethod',\n                         'status', 'createdAt', 'updatedAt'\n                       ]) &&\n                       isValidTimestamp(incoming().createdAt) &&\n                       isValidTimestamp(incoming().updatedAt);\n\n      allow update: if isValidId(creatorId) && isAdmin() &&\n                       incoming().creatorId == existing().creatorId &&\n                       incoming().createdAt == existing().createdAt &&\n                       incoming().status in ['pending', 'approved', 'rejected'] &&\n                       isValidTimestamp(incoming().updatedAt) &&\n                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);\n\n      allow delete: if isValidId(creatorId) && (isOwner(creatorId) || isAdmin());\n    }\n  }\n}\n"}]}}
