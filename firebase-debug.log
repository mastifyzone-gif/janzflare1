[debug] [2026-11-20T06:15:15.984Z] >>> [apiv2][body] PUT http://127.0.0.1:8085/emulator/v1/projects/demo-no-project:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Global safety net\n    match /{document=**} {\n      allow read, write: if false;\n    }\n\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function isValidId(id) {\n      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\\\-]+$');\n    }\n\n    function incoming() {\n      return request.resource.data;\n    }\n\n    function existing() {\n      return resource.data;\n    }\n\n    function isOwner(userId) {\n      return isSignedIn() && request.auth.uid == userId;\n    }\n\n    function isValidTimestamp(ts) {\n      return ts is timestamp && ts <= request.time;\n    }\n\n    function isFounderEmail() {\n      return isSignedIn() &&\n        request.auth.token.get('email_verified', false) == true &&\n        request.auth.token.get('email', '') == 'mdayubjanj@gmail.com';\n    }\n\n    function isAdmin() {\n      return isSignedIn() && (\n        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||\n        isFounderEmail()\n      );\n    }\n\n    // Blocks banned/suspended accounts from creating or tampering with content\n    function isActiveAccount() {\n      return isSignedIn() && (\n        !exists(/databases/$(database)/documents/creators/$(request.auth.uid)) ||\n        get(/databases/$(database)/documents/creators/$(request.auth.uid)).data.accountStatus == 'active'\n      );\n    }\n\n    function isSafeHttpsUrl(url) {\n      return url is string && url.size() >= 8 && url.size() <= 1000 && url.matches('^https://.*');\n    }\n\n    function isSafeHttpsOrEmpty(url) {\n      return url is string && (url == '' || (url.size() <= 1000 && url.matches('^https://.*')));\n    }\n\n    function isBoundedStringList(arr, maxLen) {\n      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || arr[0] is string);\n    }\n\n    function validOptionalCounterStep(oldData, newData, key, maxDelta) {\n      let oldVal = oldData.get(key, 0);\n      let newVal = newData.get(key, 0);\n      return newVal is int && newVal >= oldVal && newVal <= oldVal + maxDelta;\n    }\n\n    function isValidUserAccount(data) {\n      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&\n             data.email is string && data.email.size() <= 200 &&\n             data.username is string && data.username.size() >= 3 && data.username.size() <= 30 &&\n             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&\n             data.themeMode in ['dark', 'light', 'system'] &&\n             data.preferredLanguage is string && data.preferredLanguage.size() >= 1 && data.preferredLanguage.size() <= 30 &&\n             isBoundedStringList(data.interests, 20) &&\n             data.notifyLikes is bool &&\n             data.notifyComments is bool &&\n             data.notifyFollowers is bool &&\n             data.notifyUploads is bool &&\n             isBoundedStringList(data.blockedUserIds, 100) &&\n             isBoundedStringList(data.watchLaterVideoIds, 100) &&\n             isBoundedStringList(data.savedVideoIds, 100) &&\n             data.accountStatus in ['active', 'suspended', 'banned'] &&\n             isValidTimestamp(data.createdAt) &&\n             isValidTimestamp(data.updatedAt);\n    }\n\n    function isValidCreatorProfile(data) {\n      return data.creatorId is string && data.creatorId.size() >= 1 && data.creatorId.size() <= 128 &&\n             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&\n             data.username is string && data.username.size() >= 3 && data.username.size() <= 30 &&\n             data.bio is string && data.bio.size() <= 300 &&\n             data.avatarUrl is string && data.avatarUrl.size() <= 500 &&\n             data.coverUrl is string && data.coverUrl.size() <= 500 &&\n             data.socialLink is string && data.socialLink.size() <= 200 &&\n             (!('channelLinks' in data) || isBoundedStringList(data.channelLinks, 5)) &&\n             data.verified is bool &&\n             (!('founderAccount' in data) || data.founderAccount is bool) &&\n             (!('affiliatedBrand' in data) || (data.affiliatedBrand is string && data.affiliatedBrand.size() <= 40)) &&\n             data.accountStatus in ['active', 'suspended', 'banned'] &&\n             data.followersCount is int && data.followersCount >= 0 &&\n             data.followingCount is int && data.followingCount >= 0 &&\n             data.totalViews is int && data.totalViews >= 0 &&\n             (!('totalEngagedViews' in data) || (data.totalEngagedViews is int && data.totalEngagedViews >= 0)) &&\n             data.totalVideos is int && data.totalVideos >= 0 &&\n             data.totalWatchTimeSec is int && data.totalWatchTimeSec >= 0 &&\n             isValidTimestamp(data.createdAt) &&\n             isValidTimestamp(data.updatedAt);\n    }\n\n    function canUpdateCreator(creatorId, oldData, newData) {\n      let changed = newData.diff(oldData).affectedKeys();\n      let samePrivilege =\n        newData.verified == oldData.verified &&\n        newData.accountStatus == oldData.accountStatus &&\n        newData.get('founderAccount', false) == oldData.get('founderAccount', false) &&\n        newData.get('affiliatedBrand', '') == oldData.get('affiliatedBrand', '');\n      return\n        // Tier 1: Admin verification, affiliation & moderation\n        (\n          isAdmin() &&\n          changed.hasOnly(['verified', 'affiliatedBrand', 'founderAccount', 'accountStatus', 'updatedAt'])\n        ) ||\n        // Tier 1B: Bootstrapped founder self-upgrade\n        (\n          isOwner(creatorId) &&\n          isFounderEmail() &&\n          changed.hasOnly(['verified', 'founderAccount', 'affiliatedBrand', 'bio', 'updatedAt'])\n        ) ||\n        // Tier 2: Owner profile edit & own stats\n        (\n          isOwner(creatorId) &&\n          samePrivilege &&\n          (newData.avatarUrl == oldData.avatarUrl || isSafeHttpsOrEmpty(newData.avatarUrl)) &&\n          (newData.coverUrl == oldData.coverUrl || isSafeHttpsOrEmpty(newData.coverUrl)) &&\n          changed.hasOnly([\n            'displayName', 'username', 'bio', 'avatarUrl', 'coverUrl',\n            'socialLink', 'channelLinks', 'followingCount', 'totalVideos', 'updatedAt'\n          ])\n        ) ||\n        // Tier 3: Peer subscribe/unsubscribe delta (+1 / -1 only)\n        (\n          samePrivilege &&\n          isActiveAccount() &&\n          (newData.followersCount == oldData.followersCount + 1 || newData.followersCount == oldData.followersCount - 1) &&\n          changed.hasOnly(['followersCount', 'updatedAt'])\n        ) ||\n        // Tier 4: Peer video view/engagedView/watchTime bounded increment\n        (\n          samePrivilege &&\n          isActiveAccount() &&\n          newData.totalViews >= oldData.totalViews &&\n          newData.totalViews <= oldData.totalViews + 1 &&\n          validOptionalCounterStep(oldData, newData, 'totalEngagedViews', 1) &&\n          newData.totalWatchTimeSec >= oldData.totalWatchTimeSec &&\n          newData.totalWatchTimeSec <= oldData.totalWatchTimeSec + 15 &&\n          changed.hasOnly(['totalViews', 'totalEngagedViews', 'totalWatchTimeSec', 'updatedAt'])\n        );\n    }\n\n    function canUpdateVideo(oldData, newData) {\n      let changed = newData.diff(oldData).affectedKeys();\n      let sameModeration =\n        newData.moderationStatus == oldData.moderationStatus &&\n        newData.featured == oldData.featured &&\n        newData.trendingPinned == oldData.trendingPinned;\n      return\n        // Tier 1: Admin moderation & featuring\n        (\n          isAdmin() &&\n          changed.hasOnly(['moderationStatus', 'featured', 'trendingPinned', 'updatedAt'])\n        ) ||\n        // Tier 2: Creator metadata edit\n        (\n          oldData.creatorId == request.auth.uid &&\n          sameModeration &&\n          isActiveAccount() &&\n          (newData.thumbnailUri == oldData.thumbnailUri || isSafeHttpsOrEmpty(newData.thumbnailUri)) &&\n          changed.hasOnly([\n            'title', 'description', 'thumbnailUri', 'category', 'tags',\n            'language', 'visibility', 'processingStatus', 'updatedAt'\n          ])\n        ) ||\n        // Tier 3: Viewer engagement counters (anti-tamper strict bounded deltas)\n        (\n          sameModeration &&\n          isActiveAccount() &&\n          newData.viewsCount >= oldData.viewsCount &&\n          newData.viewsCount <= oldData.viewsCount + 1 &&\n          validOptionalCounterStep(oldData, newData, 'engagedViewsCount', 1) &&\n          newData.watchTimeTotalSec >= oldData.watchTimeTotalSec &&\n          newData.watchTimeTotalSec <= oldData.watchTimeTotalSec + 15 &&\n          newData.likesCount >= oldData.likesCount - 1 &&\n          newData.likesCount <= oldData.likesCount + 1 &&\n          newData.commentsCount >= oldData.commentsCount - 1 &&\n          newData.commentsCount <= oldData.commentsCount + 1 &&\n          newData.savesCount >= oldData.savesCount - 1 &&\n          newData.savesCount <= oldData.savesCount + 1 &&\n          changed.hasOnly([\n            'viewsCount', 'engagedViewsCount', 'likesCount', 'commentsCount', 'savesCount', 'watchTimeTotalSec', 'updatedAt'\n          ])\n        );\n    }\n\n    function isValidVideo(data) {\n      return data.creatorId is string && data.creatorId.size() >= 1 && data.creatorId.size() <= 128 &&\n             data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 60 &&\n             data.creatorUsername is string && data.creatorUsername.size() >= 3 && data.creatorUsername.size() <= 30 &&\n             data.creatorAvatarUrl is string && data.creatorAvatarUrl.size() <= 500 &&\n             data.creatorVerified is bool &&\n             data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&\n             data.description is string && data.description.size() <= 2000 &&\n             data.videoUri is string && data.videoUri.size() >= 1 && data.videoUri.size() <= 1000 &&\n             data.thumbnailUri is string && data.thumbnailUri.size() <= 1000 &&\n             data.shortForm is bool &&\n             data.featured is bool &&\n             data.trendingPinned is bool &&\n             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&\n             isBoundedStringList(data.tags, 10) &&\n             data.language is string && data.language.size() >= 1 && data.language.size() <= 30 &&\n             data.visibility in ['public', 'private', 'unlisted'] &&\n             data.moderationStatus in ['approved', 'flagged', 'removed'] &&\n             data.processingStatus in ['processing', 'ready'] &&\n             data.durationSec is int && data.durationSec >= 0 &&\n             data.viewsCount is int && data.viewsCount >= 0 &&\n             (!('engagedViewsCount' in data) || (data.engagedViewsCount is int && data.engagedViewsCount >= 0)) &&\n             data.likesCount is int && data.likesCount >= 0 &&\n             data.commentsCount is int && data.commentsCount >= 0 &&\n             data.savesCount is int && data.savesCount >= 0 &&\n             data.watchTimeTotalSec is int && data.watchTimeTotalSec >= 0 &&\n             isValidTimestamp(data.createdAt) &&\n             isValidTimestamp(data.updatedAt);\n    }\n\n    function isValidComment(data, videoId) {\n      return data.videoId == videoId &&\n             data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&\n             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60 &&\n             data.authorAvatarUrl is string && data.authorAvatarUrl.size() <= 500 &&\n             data.text is string && data.text.size() >= 1 && data.text.size() <= 500 &&\n             data.parentCommentId is string && data.parentCommentId.size() <= 128 &&\n             data.likesCount is int && data.likesCount >= 0 &&\n             data.pinned is bool &&\n             isValidTimestamp(data.createdAt) &&\n             isValidTimestamp(data.updatedAt);\n    }\n\n    function isValidPlaylist(data, userId) {\n      return data.userId == userId &&\n             data.title is string && data.title.size() >= 1 && data.title.size() <= 80 &&\n             data.description is string && data.description.size() <= 300 &&\n             isBoundedStringList(data.videoIds, 100) &&\n             data.publicVisible is bool &&\n             isValidTimestamp(data.createdAt) &&\n             isValidTimestamp(data.updatedAt);\n    }\n\n    function isValidNotification(data, userId) {\n      return data.recipientId == userId &&\n             data.actorId is string && data.actorId.size() >= 1 && data.actorId.size() <= 128 &&\n             data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 60 &&\n             data.type in ['like', 'comment', 'reply', 'follow', 'upload', 'system'] &&\n             data.message is string && data.message.size() >= 1 && data.message.size() <= 240 &&\n             data.targetVideoId is string && data.targetVideoId.size() <= 128 &&\n             data.read is bool &&\n             isValidTimestamp(data.createdAt);\n    }\n\n    function isValidReport(data) {\n      return data.reporterId is string && data.reporterId.size() >= 1 && data.reporterId.size() <= 128 &&\n             data.targetType in ['video', 'user', 'comment'] &&\n             data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128 &&\n             data.targetVideoId is string && data.targetVideoId.size() <= 128 &&\n             data.reason in 