rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isFounderEmail() {
      return isSignedIn() &&
        request.auth.token.get('email_verified', false) == true &&
        request.auth.token.get('email', '') == 'mdayubjanj@gmail.com';
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        isFounderEmail()
      );
    }

    // Blocks banned/suspended accounts from creating or tampering with content
    function isActiveAccount() {
      return isSignedIn() && (
        !exists(/databases/$(database)/documents/creators/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/creators/$(request.auth.uid)).data.accountStatus == 'active'
      );
    }

    function isSafeHttpsUrl(url) {
      return url is string && url.size() >= 8 && url.size() <= 1000 && url.matches('^https://.*');
    }

    function isSafeHttpsOrEmpty(url) {
      return url is string && (url == '' || (url.size() <= 1000 && url.matches('^https://.*')));
    }

    function isValidAdMobUnitIdOrEmpty(unitId) {
      return unitId is string && (unitId == '' || unitId.matches('^ca-app-pub-[0-9]{16}/[0-9]{10}$'));
    }

    function isBoundedStringList(arr, maxLen) {
      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || arr[0] is string);
    }

    function validOptionalCounterStep(oldData, newData, key, maxDelta) {
      let oldVal = oldData.get(key, 0);
      let newVal = newData.get(key, 0);
      return newVal is int && newVal >= oldVal && newVal <= oldVal + maxDelta;
    }

    function isValidUserAccount(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.email is string && data.email.size() <= 200 &&
             data.username is string && data.username.size() >= 3 && data.username.size() <= 30 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.themeMode in ['dark', 'light', 'system'] &&
             data.preferredLanguage is string && data.preferredLanguage.size() >= 1 && data.preferredLanguage.size() <= 30 &&
             isBoundedStringList(data.interests, 20) &&
             data.notifyLikes is bool &&
             data.notifyComments is bool &&
             data.notifyFollowers is bool &&
             data.notifyUploads is bool &&
             isBoundedStringList(data.blockedUserIds, 100) &&
             isBoundedStringList(data.watchLaterVideoIds, 100) &&
             isBoundedStringList(data.savedVideoIds, 100) &&
             data.accountStatus in ['active', 'suspended', 'banned'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidCreatorProfile(data) {
      return data.creatorId is string && data.creatorId.size() >= 1 && data.creatorId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.username is string && data.username.size() >= 3 && data.username.size() <= 30 &&
             data.bio is string && data.bio.size() <= 300 &&
             data.avatarUrl is string && data.avatarUrl.size() <= 500 &&
             data.coverUrl is string && data.coverUrl.size() <= 500 &&
             data.socialLink is string && data.socialLink.size() <= 200 &&
             (!('channelLinks' in data) || isBoundedStringList(data.channelLinks, 5)) &&
             data.verified is bool &&
             (!('founderAccount' in data) || data.founderAccount is bool) &&
             (!('affiliatedBrand' in data) || (data.affiliatedBrand is string && data.affiliatedBrand.size() <= 40)) &&
             data.accountStatus in ['active', 'suspended', 'banned'] &&
             data.followersCount is int && data.followersCount >= 0 &&
             data.followingCount is int && data.followingCount >= 0 &&
             data.totalViews is int && data.totalViews >= 0 &&
             (!('totalEngagedViews' in data) || (data.totalEngagedViews is int && data.totalEngagedViews >= 0)) &&
             data.totalVideos is int && data.totalVideos >= 0 &&
             data.totalWatchTimeSec is int && data.totalWatchTimeSec >= 0 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function canUpdateCreator(creatorId, oldData, newData) {
      let changed = newData.diff(oldData).affectedKeys();
      let samePrivilege =
        newData.verified == oldData.verified &&
        newData.accountStatus == oldData.accountStatus &&
        newData.get('founderAccount', false) == oldData.get('founderAccount', false) &&
        newData.get('affiliatedBrand', '') == oldData.get('affiliatedBrand', '');
      return
        // Tier 1: Admin verification, affiliation & moderation
        (
          isAdmin() &&
          changed.hasOnly(['verified', 'affiliatedBrand', 'founderAccount', 'accountStatus', 'updatedAt'])
        ) ||
        // Tier 1B: Bootstrapped founder self-upgrade
        (
          isOwner(creatorId) &&
          isFounderEmail() &&
          changed.hasOnly(['verified', 'founderAccount', 'affiliatedBrand', 'bio', 'updatedAt'])
        ) ||
        // Tier 2: Owner profile edit & own stats
        (
          isOwner(creatorId) &&
          samePrivilege &&
          (newData.avatarUrl == oldData.avatarUrl || isSafeHttpsOrEmpty(newData.avatarUrl)) &&
          (newData.coverUrl == oldData.coverUrl || isSafeHttpsOrEmpty(newData.coverUrl)) &&
          changed.hasOnly([
            'displayName', 'username', 'bio', 'avatarUrl', 'coverUrl',
            'socialLink', 'channelLinks', 'followingCount', 'totalVideos', 'updatedAt'
          ])
        ) ||
        // Tier 3: Peer subscribe/unsubscribe delta (+1 / -1 only)
        (
          samePrivilege &&
          isActiveAccount() &&
          (newData.followersCount == oldData.followersCount + 1 || newData.followersCount == oldData.followersCount - 1) &&
          changed.hasOnly(['followersCount', 'updatedAt'])
        ) ||
        // Tier 4: Peer video view/engagedView/watchTime bounded increment
        (
          samePrivilege &&
          isActiveAccount() &&
          newData.totalViews >= oldData.totalViews &&
          newData.totalViews <= oldData.totalViews + 1 &&
          validOptionalCounterStep(oldData, newData, 'totalEngagedViews', 1) &&
          newData.totalWatchTimeSec >= oldData.totalWatchTimeSec &&
          newData.totalWatchTimeSec <= oldData.totalWatchTimeSec + 15 &&
          changed.hasOnly(['totalViews', 'totalEngagedViews', 'totalWatchTimeSec', 'updatedAt'])
        );
    }

    function canUpdateVideo(oldData, newData) {
      let changed = newData.diff(oldData).affectedKeys();
      let sameModeration =
        newData.moderationStatus == oldData.moderationStatus &&
        newData.featured == oldData.featured &&
        newData.trendingPinned == oldData.trendingPinned;
      return
        // Tier 1: Admin moderation & featuring
        (
          isAdmin() &&
          changed.hasOnly(['moderationStatus', 'featured', 'trendingPinned', 'updatedAt'])
        ) ||
        // Tier 2: Creator metadata edit
        (
          oldData.creatorId == request.auth.uid &&
          sameModeration &&
          isActiveAccount() &&
          (newData.thumbnailUri == oldData.thumbnailUri || isSafeHttpsOrEmpty(newData.thumbnailUri)) &&
          changed.hasOnly([
            'title', 'description', 'thumbnailUri', 'category', 'tags',
            'language', 'visibility', 'processingStatus', 'updatedAt'
          ])
        ) ||
        // Tier 3: Viewer engagement counters (anti-tamper strict bounded deltas)
        (
          sameModeration &&
          isActiveAccount() &&
          newData.viewsCount >= oldData.viewsCount &&
          newData.viewsCount <= oldData.viewsCount + 1 &&
          validOptionalCounterStep(oldData, newData, 'engagedViewsCount', 1) &&
          newData.watchTimeTotalSec >= oldData.watchTimeTotalSec &&
          newData.watchTimeTotalSec <= oldData.watchTimeTotalSec + 15 &&
          newData.likesCount >= oldData.likesCount - 1 &&
          newData.likesCount <= oldData.likesCount + 1 &&
          newData.commentsCount >= oldData.commentsCount - 1 &&
          newData.commentsCount <= oldData.commentsCount + 1 &&
          newData.savesCount >= oldData.savesCount - 1 &&
          newData.savesCount <= oldData.savesCount + 1 &&
          changed.hasOnly([
            'viewsCount', 'engagedViewsCount', 'likesCount', 'commentsCount', 'savesCount', 'watchTimeTotalSec', 'updatedAt'
          ])
        );
    }

    function isValidVideo(data) {
      return data.creatorId is string && data.creatorId.size() >= 1 && data.creatorId.size() <= 128 &&
             data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 60 &&
             data.creatorUsername is string && data.creatorUsername.size() >= 3 && data.creatorUsername.size() <= 30 &&
             data.creatorAvatarUrl is string && data.creatorAvatarUrl.size() <= 500 &&
             data.creatorVerified is bool &&
             data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
             data.description is string && data.description.size() <= 2000 &&
             data.videoUri is string && data.videoUri.size() >= 1 && data.videoUri.size() <= 1000 &&
             data.thumbnailUri is string && data.thumbnailUri.size() <= 1000 &&
             data.shortForm is bool &&
             data.featured is bool &&
             data.trendingPinned is bool &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             isBoundedStringList(data.tags, 10) &&
             data.language is string && data.language.size() >= 1 && data.language.size() <= 30 &&
             data.visibility in ['public', 'private', 'unlisted'] &&
             data.moderationStatus in ['approved', 'flagged', 'removed'] &&
             data.processingStatus in ['processing', 'ready'] &&
             data.durationSec is int && data.durationSec >= 0 &&
             data.viewsCount is int && data.viewsCount >= 0 &&
             (!('engagedViewsCount' in data) || (data.engagedViewsCount is int && data.engagedViewsCount >= 0)) &&
             data.likesCount is int && data.likesCount >= 0 &&
             data.commentsCount is int && data.commentsCount >= 0 &&
             data.savesCount is int && data.savesCount >= 0 &&
             data.watchTimeTotalSec is int && data.watchTimeTotalSec >= 0 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidComment(data, videoId) {
      return data.videoId == videoId &&
             data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60 &&
             data.authorAvatarUrl is string && data.authorAvatarUrl.size() <= 500 &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 500 &&
             data.parentCommentId is string && data.parentCommentId.size() <= 128 &&
             data.likesCount is int && data.likesCount >= 0 &&
             data.pinned is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidPlaylist(data, userId) {
      return data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 80 &&
             data.description is string && data.description.size() <= 300 &&
             isBoundedStringList(data.videoIds, 100) &&
             data.publicVisible is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidNotification(data, userId) {
      return data.recipientId == userId &&
             data.actorId is string && data.actorId.size() >= 1 && data.actorId.size() <= 128 &&
             data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 60 &&
             data.type in ['like', 'comment', 'reply', 'follow', 'upload', 'system'] &&
             data.message is string && data.message.size() >= 1 && data.message.size() <= 240 &&
             data.targetVideoId is string && data.targetVideoId.size() <= 128 &&
             data.read is bool &&
             isValidTimestamp(data.createdAt);
    }

    function isValidReport(data) {
      return data.reporterId is string && data.reporterId.size() >= 1 && data.reporterId.size() <= 128 &&
             data.targetType in ['video', 'user', 'comment'] &&
             data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128 &&
             data.targetVideoId is string && data.targetVideoId.size() <= 128 &&
             data.reason in ['spam', 'harassment', 'copyright', 'misinformation', 'violence', 'other'] &&
             data.details is string && data.details.size() <= 500 &&
             data.status in ['open', 'reviewed', 'resolved', 'dismissed'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidPlatformSettings(data) {
      return isBoundedStringList(data.disabledCategories, 30) &&
             data.featuredBannerText is string && data.featuredBannerText.size() <= 200 &&
             data.maintenanceNotice is string && data.maintenanceNotice.size() <= 300 &&
             (!('latestVersionCode' in data) || (data.latestVersionCode is int && data.latestVersionCode >= 1 && data.latestVersionCode <= 1000000)) &&
             (!('latestVersionName' in data) || (data.latestVersionName is string && data.latestVersionName.size() <= 30)) &&
             (!('updateUrl' in data) || isSafeHttpsOrEmpty(data.updateUrl)) &&
             (!('updateNotes' in data) || (data.updateNotes is string && data.updateNotes.size() <= 500)) &&
             (!('forceUpdate' in data) || data.forceUpdate is bool) &&
             (!('shareAppUrl' in data) || isSafeHttpsOrEmpty(data.shareAppUrl)) &&
             (!('sharePromoText' in data) || (data.sharePromoText is string && data.sharePromoText.size() <= 120)) &&
             (!('adsEnabled' in data) || data.adsEnabled is bool) &&
             (!('adPreRollEnabled' in data) || data.adPreRollEnabled is bool) &&
             (!('adMidRollEnabled' in data) || data.adMidRollEnabled is bool) &&
             (!('adPostRollEnabled' in data) || data.adPostRollEnabled is bool) &&
             (!('adSkipAfterSec' in data) || (data.adSkipAfterSec is int && data.adSkipAfterSec >= 0 && data.adSkipAfterSec <= 30)) &&
             (!('adDurationSec' in data) || (data.adDurationSec is int && data.adDurationSec >= 5 && data.adDurationSec <= 60)) &&
             (!('adTitle' in data) || (data.adTitle is string && data.adTitle.size() <= 100)) &&
             (!('adDescription' in data) || (data.adDescription is string && data.adDescription.size() <= 240)) &&
             (!('adMediaUrl' in data) || isSafeHttpsOrEmpty(data.adMediaUrl)) &&
             (!('adClickUrl' in data) || isSafeHttpsOrEmpty(data.adClickUrl)) &&
             (!('admobTestMode' in data) || data.admobTestMode is bool) &&
             (!('admobBannerEnabled' in data) || data.admobBannerEnabled is bool) &&
             (!('admobBannerUnitId' in data) || isValidAdMobUnitIdOrEmpty(data.admobBannerUnitId)) &&
             (!('admobVideoInterstitialUnitId' in data) || isValidAdMobUnitIdOrEmpty(data.admobVideoInterstitialUnitId)) &&
             (!('admobShortsInterstitialUnitId' in data) || isValidAdMobUnitIdOrEmpty(data.admobShortsInterstitialUnitId)) &&
             (!('admobShortsInterval' in data) || (data.admobShortsInterval is int && data.admobShortsInterval >= 2 && data.admobShortsInterval <= 30)) &&
             (!('admobCooldownSec' in data) || (data.admobCooldownSec is int && data.admobCooldownSec >= 30 && data.admobCooldownSec <= 1800)) &&
             isValidTimestamp(data.updatedAt);
    }

    // 1. Private User Account (PII isolated)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isValidId(userId) &&
                       isOwner(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().accountStatus == 'active' &&
                       incoming().keys().hasAll([
                         'userId', 'email', 'username', 'displayName', 'themeMode',
                         'preferredLanguage', 'interests', 'notifyLikes', 'notifyComments',
                         'notifyFollowers', 'notifyUploads', 'blockedUserIds',
                         'watchLaterVideoIds', 'savedVideoIds', 'accountStatus',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'email', 'username', 'displayName', 'themeMode',
                         'preferredLanguage', 'interests', 'notifyLikes', 'notifyComments',
                         'notifyFollowers', 'notifyUploads', 'blockedUserIds',
                         'watchLaterVideoIds', 'savedVideoIds', 'accountStatus',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserAccount(incoming());

      allow update: if isValidId(userId) && isSignedIn() && isValidUserAccount(incoming()) && (
        (
          isAdmin() &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['accountStatus', 'updatedAt'])
        ) || (
          isOwner(userId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().accountStatus == existing().accountStatus &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'username', 'displayName', 'themeMode', 'preferredLanguage',
            'interests', 'notifyLikes', 'notifyComments', 'notifyFollowers',
            'notifyUploads', 'blockedUserIds', 'watchLaterVideoIds',
            'savedVideoIds', 'updatedAt'
          ])
        )
      );

      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());

      // Likes subcollection
      match /likes/{videoId} {
        allow get: if isValidId(userId) && isValidId(videoId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(videoId) && isOwner(userId) && isActiveAccount() &&
                         incoming().userId == request.auth.uid &&
                         incoming().videoId == videoId &&
                         incoming().keys().hasAll(['userId', 'videoId', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'videoId', 'createdAt']) &&
                         isValidTimestamp(incoming().createdAt) &&
                         exists(/databases/$(database)/documents/videos/$(videoId));
        allow delete: if isValidId(userId) && isValidId(videoId) && isOwner(userId);
      }

      // Following / Subscribed subcollection
      match /following/{creatorId} {
        allow get: if isValidId(userId) && isValidId(creatorId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(creatorId) && isOwner(userId) && isActiveAccount() &&
                         incoming().userId == request.auth.uid &&
                         incoming().creatorId == creatorId &&
                         incoming().creatorName is string && incoming().creatorName.size() >= 1 && incoming().creatorName.size() <= 60 &&
                         incoming().creatorAvatarUrl is string && incoming().creatorAvatarUrl.size() <= 500 &&
                         incoming().notifyOnUpload is bool &&
                         incoming().keys().hasAll(['userId', 'creatorId', 'creatorName', 'creatorAvatarUrl', 'notifyOnUpload', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'creatorId', 'creatorName', 'creatorAvatarUrl', 'notifyOnUpload', 'createdAt']) &&
                         isValidTimestamp(incoming().createdAt);
        allow update: if isValidId(userId) && isValidId(creatorId) && isOwner(userId) &&
                         incoming().userId == existing().userId &&
                         incoming().creatorId == existing().creatorId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().notifyOnUpload is bool &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['notifyOnUpload']);
        allow delete: if isValidId(userId) && isValidId(creatorId) && isOwner(userId);
      }

      // Watch history subcollection
      match /watchHistory/{videoId} {
        allow get: if isValidId(userId) && isValidId(videoId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(videoId) && isOwner(userId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().videoId == videoId &&
                         incoming().category is string && incoming().category.size() >= 1 && incoming().category.size() <= 40 &&
                         incoming().language is string && incoming().language.size() >= 1 && incoming().language.size() <= 30 &&
                         incoming().creatorId is string && incoming().creatorId.size() >= 1 && incoming().creatorId.size() <= 128 &&
                         incoming().watchedSec is int && incoming().watchedSec >= 0 && incoming().watchedSec <= 15 &&
                         incoming().keys().hasAll(['userId', 'videoId', 'category', 'language', 'creatorId', 'watchedSec', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'videoId', 'category', 'language', 'creatorId', 'watchedSec', 'createdAt', 'updatedAt']) &&
                         isValidTimestamp(incoming().createdAt) &&
                         isValidTimestamp(incoming().updatedAt);
        allow update: if isValidId(userId) && isValidId(videoId) && isOwner(userId) &&
                         incoming().userId == existing().userId &&
                         incoming().videoId == existing().videoId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().watchedSec is int && incoming().watchedSec >= existing().watchedSec &&
                         incoming().watchedSec <= existing().watchedSec + 15 &&
                         isValidTimestamp(incoming().updatedAt) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['watchedSec', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(videoId) && isOwner(userId);
      }

      // Playlists subcollection
      match /playlists/{playlistId} {
        allow get: if isValidId(userId) && isValidId(playlistId) && (isOwner(userId) || (isSignedIn() && existing().publicVisible == true));
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(playlistId) && isOwner(userId) && isActiveAccount() &&
                         incoming().keys().hasAll(['userId', 'title', 'description', 'videoIds', 'publicVisible', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'description', 'videoIds', 'publicVisible', 'createdAt', 'updatedAt']) &&
                         isValidPlaylist(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(playlistId) && isOwner(userId) &&
                         isValidPlaylist(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'videoIds', 'publicVisible', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(playlistId) && isOwner(userId);
      }

      // Notifications subcollection
      match /notifications/{notificationId} {
        allow get: if isValidId(userId) && isValidId(notificationId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(notificationId) && isActiveAccount() &&
                         incoming().actorId == request.auth.uid &&
                         incoming().keys().hasAll(['recipientId', 'actorId', 'actorName', 'type', 'message', 'targetVideoId', 'read', 'createdAt']) &&
                         incoming().keys().hasOnly(['recipientId', 'actorId', 'actorName', 'type', 'message', 'targetVideoId', 'read', 'createdAt']) &&
                         isValidNotification(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(notificationId) && isOwner(userId) &&
                         isValidNotification(incoming(), userId) &&
                         incoming().recipientId == existing().recipientId &&
                         incoming().actorId == existing().actorId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['read']);
        allow delete: if isValidId(userId) && isValidId(notificationId) && isOwner(userId);
      }
    }

    // 2. Public Creator Profiles (No PII)
    match /creators/{creatorId} {
      allow get: if isValidId(creatorId) && isSignedIn();
      allow list: if isSignedIn() && (existing().accountStatus == 'active' || existing().creatorId == request.auth.uid || isAdmin());

      allow create: if isValidId(creatorId) &&
                       isOwner(creatorId) &&
                       incoming().creatorId == request.auth.uid &&
                       (isFounderEmail() || (incoming().verified == false && incoming().founderAccount == false && incoming().affiliatedBrand == '')) &&
                       incoming().accountStatus == 'active' &&
                       incoming().followersCount == 0 &&
                       incoming().followingCount == 0 &&
                       incoming().totalViews == 0 &&
                       (!('totalEngagedViews' in incoming()) || incoming().totalEngagedViews == 0) &&
                       incoming().totalVideos == 0 &&
                       incoming().totalWatchTimeSec == 0 &&
                       isSafeHttpsOrEmpty(incoming().avatarUrl) &&
                       isSafeHttpsOrEmpty(incoming().coverUrl) &&
                       incoming().keys().hasAll([
                         'creatorId', 'displayName', 'username', 'bio', 'avatarUrl',
                         'coverUrl', 'socialLink', 'verified', 'founderAccount', 'affiliatedBrand',
                         'accountStatus', 'followersCount', 'followingCount', 'totalViews',
                         'totalVideos', 'totalWatchTimeSec', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'creatorId', 'displayName', 'username', 'bio', 'avatarUrl',
                         'coverUrl', 'socialLink', 'channelLinks', 'verified', 'founderAccount', 'affiliatedBrand',
                         'accountStatus', 'followersCount', 'followingCount', 'totalViews',
                         'totalEngagedViews', 'totalVideos', 'totalWatchTimeSec', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidCreatorProfile(incoming());

      allow update: if isValidId(creatorId) && isSignedIn() &&
                       request.resource.data.creatorId == resource.data.creatorId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       isValidCreatorProfile(request.resource.data) &&
                       canUpdateCreator(creatorId, resource.data, request.resource.data);

      allow delete: if isValidId(creatorId) && (isOwner(creatorId) || isAdmin());

      // Privacy-safe subscriber notification registry
      match /subscribers/{subscriberId} {
        allow get: if isValidId(creatorId) && isValidId(subscriberId) && (isOwner(subscriberId) || isOwner(creatorId) || isAdmin());
        allow list: if isValidId(creatorId) && (isOwner(creatorId) || isAdmin());
        allow create, update: if isValidId(creatorId) && isValidId(subscriberId) && isOwner(subscriberId) && isActiveAccount() &&
                                 incoming().subscriberId == request.auth.uid &&
                                 incoming().notifyOnUpload is bool &&
                                 incoming().keys().hasAll(['subscriberId', 'notifyOnUpload', 'createdAt']) &&
                                 incoming().keys().hasOnly(['subscriberId', 'notifyOnUpload', 'createdAt']) &&
                                 isValidTimestamp(incoming().createdAt);
        allow delete: if isValidId(creatorId) && isValidId(subscriberId) && (isOwner(subscriberId) || isAdmin());
      }
    }

    // 3. Videos & Shorts
    match /videos/{videoId} {
      allow get: if isValidId(videoId) && isSignedIn() && (
        (existing().visibility in ['public', 'unlisted'] && existing().moderationStatus == 'approved') ||
        existing().creatorId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        (existing().visibility == 'public' && existing().moderationStatus == 'approved') ||
        existing().creatorId == request.auth.uid ||
        isAdmin()
      );

      allow create: if isValidId(videoId) &&
                       isActiveAccount() &&
                       incoming().creatorId == request.auth.uid &&
                       incoming().featured == false &&
                       incoming().trendingPinned == false &&
                       incoming().moderationStatus == 'approved' &&
                       incoming().viewsCount == 0 &&
                       (!('engagedViewsCount' in incoming()) || incoming().engagedViewsCount == 0) &&
                       incoming().likesCount == 0 &&
                       incoming().commentsCount == 0 &&
                       incoming().savesCount == 0 &&
                       incoming().watchTimeTotalSec == 0 &&
                       isSafeHttpsUrl(incoming().videoUri) &&
                       isSafeHttpsOrEmpty(incoming().thumbnailUri) &&
                       incoming().keys().hasAll([
                         'creatorId', 'creatorName', 'creatorUsername', 'creatorAvatarUrl',
                         'creatorVerified', 'title', 'description', 'videoUri', 'thumbnailUri',
                         'shortForm', 'featured', 'trendingPinned', 'category', 'tags',
                         'language', 'visibility', 'moderationStatus', 'processingStatus',
                         'durationSec', 'viewsCount', 'likesCount', 'commentsCount',
                         'savesCount', 'watchTimeTotalSec', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'creatorId', 'creatorName', 'creatorUsername', 'creatorAvatarUrl',
                         'creatorVerified', 'title', 'description', 'videoUri', 'thumbnailUri',
                         'shortForm', 'featured', 'trendingPinned', 'category', 'tags',
                         'language', 'visibility', 'moderationStatus', 'processingStatus',
                         'durationSec', 'viewsCount', 'engagedViewsCount', 'likesCount', 'commentsCount',
                         'savesCount', 'watchTimeTotalSec', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidVideo(incoming());

      allow update: if isValidId(videoId) && isSignedIn() &&
                       request.resource.data.creatorId == resource.data.creatorId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       isValidVideo(request.resource.data) &&
                       canUpdateVideo(resource.data, request.resource.data);

      allow delete: if isValidId(videoId) && isSignedIn() && (existing().creatorId == request.auth.uid || isAdmin());

      // Comments subcollection
      match /comments/{commentId} {
        allow get: if isValidId(videoId) && isValidId(commentId) && isSignedIn();
        allow list: if isValidId(videoId) && isSignedIn() && existing().videoId == videoId;

        allow create: if isValidId(videoId) && isValidId(commentId) && isActiveAccount() &&
                         incoming().authorId == request.auth.uid &&
                         incoming().pinned == false &&
                         incoming().likesCount == 0 &&
                         incoming().keys().hasAll([
                           'videoId', 'authorId', 'authorName', 'authorAvatarUrl', 'text',
                           'parentCommentId', 'likesCount', 'pinned', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'videoId', 'authorId', 'authorName', 'authorAvatarUrl', 'text',
                           'parentCommentId', 'likesCount', 'pinned', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidComment(incoming(), videoId) &&
                         exists(/databases/$(database)/documents/videos/$(videoId));

        allow update: if isValidId(videoId) && isValidId(commentId) && isSignedIn() &&
                         isValidComment(incoming(), videoId) &&
                         incoming().videoId == existing().videoId &&
                         incoming().authorId == existing().authorId &&
                         incoming().createdAt == existing().createdAt && (
          isAdmin() ||
          (
            existing().authorId == request.auth.uid &&
            isActiveAccount() &&
            incoming().pinned == existing().pinned &&
            incoming().diff(existing()).affectedKeys().hasOnly(['text', 'updatedAt'])
          ) ||
          (
            get(/databases/$(database)/documents/videos/$(videoId)).data.creatorId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['pinned', 'updatedAt'])
          ) ||
          (
            isActiveAccount() &&
            incoming().pinned == existing().pinned &&
            incoming().likesCount >= existing().likesCount - 1 &&
            incoming().likesCount <= existing().likesCount + 1 &&
            incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt'])
          )
        );

        allow delete: if isValidId(videoId) && isValidId(commentId) && isSignedIn() && (
          existing().authorId == request.auth.uid ||
          get(/databases/$(database)/documents/videos/$(videoId)).data.creatorId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // 4. Moderation Reports
    match /reports/{reportId} {
      allow get: if isValidId(reportId) && isSignedIn() && (existing().reporterId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().reporterId == request.auth.uid || isAdmin());

      allow create: if isValidId(reportId) && isActiveAccount() &&
                       incoming().reporterId == request.auth.uid &&
                       incoming().status == 'open' &&
                       incoming().keys().hasAll([
                         'reporterId', 'targetType', 'targetId', 'targetVideoId',
                         'reason', 'details', 'status', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'reporterId', 'targetType', 'targetId', 'targetVideoId',
                         'reason', 'details', 'status', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidReport(incoming());

      allow update: if isValidId(reportId) && isAdmin() &&
                       isValidReport(incoming()) &&
                       incoming().reporterId == existing().reporterId &&
                       incoming().createdAt == existing().createdAt &&
                       existing().status != 'resolved' &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if isValidId(reportId) && isAdmin();
    }

    // 5. Platform Settings (Admin-controlled categories, banners, updates, external share link & ads)
    match /platformSettings/{settingId} {
      allow get: if isValidId(settingId) && isSignedIn();
      allow list: if isSignedIn() && existing().featuredBannerText is string;
      allow create, update: if isValidId(settingId) && isAdmin() &&
                               incoming().keys().hasAll(['disabledCategories', 'featuredBannerText', 'maintenanceNotice', 'updatedAt']) &&
                               incoming().keys().hasOnly([
                                 'disabledCategories', 'featuredBannerText', 'maintenanceNotice',
                                 'latestVersionCode', 'latestVersionName', 'updateUrl', 'updateNotes', 'forceUpdate',
                                 'shareAppUrl', 'sharePromoText',
                                 'adsEnabled', 'adPreRollEnabled', 'adMidRollEnabled', 'adPostRollEnabled',
                                 'adSkipAfterSec', 'adDurationSec', 'adTitle', 'adDescription', 'adMediaUrl', 'adClickUrl',
                                 'admobTestMode', 'admobBannerEnabled', 'admobBannerUnitId',
                                 'admobVideoInterstitialUnitId', 'admobShortsInterstitialUnitId',
                                 'admobShortsInterval', 'admobCooldownSec',
                                 'updatedAt'
                               ]) &&
                               isValidPlatformSettings(incoming());
      allow delete: if isValidId(settingId) && isAdmin();
    }

    // 6. Admins Registry
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isValidId(adminUid) && isAdmin();
    }

    // 7. Creator Monetization Requests (500 subs + 1000 watch hrs OR 100K Shorts engaged views)
    match /monetizationRequests/{creatorId} {
      allow get: if isValidId(creatorId) && (isOwner(creatorId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isValidId(creatorId) &&
                       isOwner(creatorId) &&
                       incoming().creatorId == request.auth.uid &&
                       incoming().status == 'pending' &&
                       incoming().displayName is string && incoming().displayName.size() >= 1 && incoming().displayName.size() <= 60 &&
                       incoming().username is string && incoming().username.size() >= 3 && incoming().username.size() <= 30 &&
                       incoming().followersCount is int && incoming().followersCount >= 500 &&
                       incoming().watchTimeHours is int && incoming().watchTimeHours >= 0 &&
                       incoming().shortsEngagementViews is int && incoming().shortsEngagementViews >= 0 &&
                       (incoming().watchTimeHours >= 1000 || incoming().shortsEngagementViews >= 100000) &&
                       incoming().payoutMethod in ['UPI', 'Bank Transfer'] &&
                       get(/databases/$(database)/documents/creators/$(creatorId)).data.accountStatus == 'active' &&
                       get(/databases/$(database)/documents/creators/$(creatorId)).data.followersCount >= 500 &&
                       (
                         (incoming().watchTimeHours >= 1000 && get(/databases/$(database)/documents/creators/$(creatorId)).data.totalWatchTimeSec >= 3600000) ||
                         (incoming().shortsEngagementViews >= 100000 && (
                           get(/databases/$(database)/documents/creators/$(creatorId)).data.totalViews >= 100000 ||
                           ('totalEngagedViews' in get(/databases/$(database)/documents/creators/$(creatorId)).data &&
                            get(/databases/$(database)/documents/creators/$(creatorId)).data.totalEngagedViews >= 100000)
                         ))
                       ) &&
                       incoming().keys().hasAll([
                         'creatorId', 'displayName', 'username', 'followersCount',
                         'watchTimeHours', 'shortsEngagementViews', 'payoutMethod',
                         'status', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'creatorId', 'displayName', 'username', 'followersCount',
                         'watchTimeHours', 'shortsEngagementViews', 'payoutMethod',
                         'status', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt);

      allow update: if isValidId(creatorId) && isAdmin() &&
                       incoming().creatorId == existing().creatorId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().status in ['pending', 'approved', 'rejected'] &&
                       isValidTimestamp(incoming().updatedAt) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if isValidId(creatorId) && (isOwner(creatorId) || isAdmin());
    }
  }
}
