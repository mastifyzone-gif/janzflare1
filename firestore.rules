rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email_verified == true && request.auth.token.email == 'mdayubjanj@gmail.com')
      );
    }

    function isBoundedStringList(arr, maxLen) {
      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || arr[0] is string);
    }

    function isValidUserAccount(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.email is string && data.email.size() <= 200 &&
             data.username is string && data.username.size() >= 3 && data.username.size() <= 30 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.themeMode in ['dark', 'light', 'system'] &&
             data.preferredLanguage is string && data.preferredLanguage.size() >= 1 && data.preferredLanguage.size() <= 30 &&
             isBoundedStringList(data.interests, 20) &&
             data.notifyLikes is bool &&
             data.notifyComments is bool &&
             data.notifyFollowers is bool &&
             data.notifyUploads is bool &&
             isBoundedStringList(data.blockedUserIds, 100) &&
             isBoundedStringList(data.watchLaterVideoIds, 100) &&
             isBoundedStringList(data.savedVideoIds, 100) &&
             data.accountStatus in ['active', 'suspended', 'banned'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidCreatorProfile(data) {
      return data.creatorId is string && data.creatorId.size() >= 1 && data.creatorId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.username is string && data.username.size() >= 3 && data.username.size() <= 30 &&
             data.bio is string && data.bio.size() <= 300 &&
             data.avatarUrl is string && data.avatarUrl.size() <= 500 &&
             data.coverUrl is string && data.coverUrl.size() <= 500 &&
             data.socialLink is string && data.socialLink.size() <= 200 &&
             data.verified is bool &&
             data.accountStatus in ['active', 'suspended', 'banned'] &&
             data.followersCount is int && data.followersCount >= 0 &&
             data.followingCount is int && data.followingCount >= 0 &&
             data.totalViews is int && data.totalViews >= 0 &&
             data.totalVideos is int && data.totalVideos >= 0 &&
             data.totalWatchTimeSec is int && data.totalWatchTimeSec >= 0 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidVideo(data) {
      return data.creatorId is string && data.creatorId.size() >= 1 && data.creatorId.size() <= 128 &&
             data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 60 &&
             data.creatorUsername is string && data.creatorUsername.size() >= 3 && data.creatorUsername.size() <= 30 &&
             data.creatorAvatarUrl is string && data.creatorAvatarUrl.size() <= 500 &&
             data.creatorVerified is bool &&
             data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
             data.description is string && data.description.size() <= 2000 &&
             data.videoUri is string && data.videoUri.size() >= 1 && data.videoUri.size() <= 1000 &&
             data.thumbnailUri is string && data.thumbnailUri.size() <= 1000 &&
             data.shortForm is bool &&
             data.featured is bool &&
             data.trendingPinned is bool &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             isBoundedStringList(data.tags, 10) &&
             data.language is string && data.language.size() >= 1 && data.language.size() <= 30 &&
             data.visibility in ['public', 'private', 'unlisted'] &&
             data.moderationStatus in ['approved', 'flagged', 'removed'] &&
             data.processingStatus in ['processing', 'ready'] &&
             data.durationSec is int && data.durationSec >= 0 &&
             data.viewsCount is int && data.viewsCount >= 0 &&
             data.likesCount is int && data.likesCount >= 0 &&
             data.commentsCount is int && data.commentsCount >= 0 &&
             data.savesCount is int && data.savesCount >= 0 &&
             data.watchTimeTotalSec is int && data.watchTimeTotalSec >= 0 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidComment(data, videoId) {
      return data.videoId == videoId &&
             data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60 &&
             data.authorAvatarUrl is string && data.authorAvatarUrl.size() <= 500 &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 500 &&
             data.parentCommentId is string && data.parentCommentId.size() <= 128 &&
             data.likesCount is int && data.likesCount >= 0 &&
             data.pinned is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidPlaylist(data, userId) {
      return data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 80 &&
             data.description is string && data.description.size() <= 300 &&
             isBoundedStringList(data.videoIds, 100) &&
             data.publicVisible is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidNotification(data, userId) {
      return data.recipientId == userId &&
             data.actorId is string && data.actorId.size() >= 1 && data.actorId.size() <= 128 &&
             data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 60 &&
             data.type in ['like', 'comment', 'reply', 'follow', 'upload', 'system'] &&
             data.message is string && data.message.size() >= 1 && data.message.size() <= 240 &&
             data.targetVideoId is string && data.targetVideoId.size() <= 128 &&
             data.read is bool &&
             isValidTimestamp(data.createdAt);
    }

    function isValidReport(data) {
      return data.reporterId is string && data.reporterId.size() >= 1 && data.reporterId.size() <= 128 &&
             data.targetType in ['video', 'user', 'comment'] &&
             data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128 &&
             data.targetVideoId is string && data.targetVideoId.size() <= 128 &&
             data.reason in ['spam', 'harassment', 'copyright', 'misinformation', 'violence', 'other'] &&
             data.details is string && data.details.size() <= 500 &&
             data.status in ['open', 'reviewed', 'resolved', 'dismissed'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // 1. Private User Account (PII isolated)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isValidId(userId) &&
                       isOwner(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().accountStatus == 'active' &&
                       incoming().keys().hasAll([
                         'userId', 'email', 'username', 'displayName', 'themeMode',
                         'preferredLanguage', 'interests', 'notifyLikes', 'notifyComments',
                         'notifyFollowers', 'notifyUploads', 'blockedUserIds',
                         'watchLaterVideoIds', 'savedVideoIds', 'accountStatus',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'email', 'username', 'displayName', 'themeMode',
                         'preferredLanguage', 'interests', 'notifyLikes', 'notifyComments',
                         'notifyFollowers', 'notifyUploads', 'blockedUserIds',
                         'watchLaterVideoIds', 'savedVideoIds', 'accountStatus',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserAccount(incoming());

      allow update: if isValidId(userId) && isSignedIn() && isValidUserAccount(incoming()) && (
        (
          isAdmin() &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['accountStatus', 'updatedAt'])
        ) || (
          isOwner(userId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().accountStatus == existing().accountStatus &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'username', 'displayName', 'themeMode', 'preferredLanguage',
            'interests', 'notifyLikes', 'notifyComments', 'notifyFollowers',
            'notifyUploads', 'blockedUserIds', 'watchLaterVideoIds',
            'savedVideoIds', 'updatedAt'
          ])
        )
      );

      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());

      // Likes subcollection
      match /likes/{videoId} {
        allow get: if isValidId(userId) && isValidId(videoId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(videoId) && isOwner(userId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().videoId == videoId &&
                         incoming().keys().hasAll(['userId', 'videoId', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'videoId', 'createdAt']) &&
                         isValidTimestamp(incoming().createdAt) &&
                         exists(/databases/$(database)/documents/videos/$(videoId));
        allow delete: if isValidId(userId) && isValidId(videoId) && isOwner(userId);
      }

      // Following subcollection
      match /following/{creatorId} {
        allow get: if isValidId(userId) && isValidId(creatorId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(creatorId) && isOwner(userId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().creatorId == creatorId &&
                         incoming().creatorName is string && incoming().creatorName.size() >= 1 && incoming().creatorName.size() <= 60 &&
                         incoming().creatorAvatarUrl is string && incoming().creatorAvatarUrl.size() <= 500 &&
                         incoming().keys().hasAll(['userId', 'creatorId', 'creatorName', 'creatorAvatarUrl', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'creatorId', 'creatorName', 'creatorAvatarUrl', 'createdAt']) &&
                         isValidTimestamp(incoming().createdAt);
        allow delete: if isValidId(userId) && isValidId(creatorId) && isOwner(userId);
      }

      // Watch history subcollection
      match /watchHistory/{videoId} {
        allow get: if isValidId(userId) && isValidId(videoId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(videoId) && isOwner(userId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().videoId == videoId &&
                         incoming().category is string && incoming().category.size() >= 1 && incoming().category.size() <= 40 &&
                         incoming().language is string && incoming().language.size() >= 1 && incoming().language.size() <= 30 &&
                         incoming().creatorId is string && incoming().creatorId.size() >= 1 && incoming().creatorId.size() <= 128 &&
                         incoming().watchedSec is int && incoming().watchedSec >= 0 &&
                         incoming().keys().hasAll(['userId', 'videoId', 'category', 'language', 'creatorId', 'watchedSec', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'videoId', 'category', 'language', 'creatorId', 'watchedSec', 'createdAt', 'updatedAt']) &&
                         isValidTimestamp(incoming().createdAt) &&
                         isValidTimestamp(incoming().updatedAt);
        allow update: if isValidId(userId) && isValidId(videoId) && isOwner(userId) &&
                         incoming().userId == existing().userId &&
                         incoming().videoId == existing().videoId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().watchedSec is int && incoming().watchedSec >= 0 &&
                         isValidTimestamp(incoming().updatedAt) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['watchedSec', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(videoId) && isOwner(userId);
      }

      // Playlists subcollection
      match /playlists/{playlistId} {
        allow get: if isValidId(userId) && isValidId(playlistId) && (isOwner(userId) || (isSignedIn() && existing().publicVisible == true));
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(playlistId) && isOwner(userId) &&
                         incoming().keys().hasAll(['userId', 'title', 'description', 'videoIds', 'publicVisible', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'description', 'videoIds', 'publicVisible', 'createdAt', 'updatedAt']) &&
                         isValidPlaylist(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(playlistId) && isOwner(userId) &&
                         isValidPlaylist(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'videoIds', 'publicVisible', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(playlistId) && isOwner(userId);
      }

      // Notifications subcollection
      match /notifications/{notificationId} {
        allow get: if isValidId(userId) && isValidId(notificationId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(notificationId) && isSignedIn() &&
                         incoming().actorId == request.auth.uid &&
                         incoming().keys().hasAll(['recipientId', 'actorId', 'actorName', 'type', 'message', 'targetVideoId', 'read', 'createdAt']) &&
                         incoming().keys().hasOnly(['recipientId', 'actorId', 'actorName', 'type', 'message', 'targetVideoId', 'read', 'createdAt']) &&
                         isValidNotification(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(notificationId) && isOwner(userId) &&
                         isValidNotification(incoming(), userId) &&
                         incoming().recipientId == existing().recipientId &&
                         incoming().actorId == existing().actorId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['read']);
        allow delete: if isValidId(userId) && isValidId(notificationId) && isOwner(userId);
      }
    }

    // 2. Public Creator Profiles (No PII)
    match /creators/{creatorId} {
      allow get: if isValidId(creatorId) && isSignedIn();
      allow list: if isSignedIn() && (existing().accountStatus == 'active' || existing().creatorId == request.auth.uid || isAdmin());

      allow create: if isValidId(creatorId) &&
                       isOwner(creatorId) &&
                       incoming().creatorId == request.auth.uid &&
                       incoming().verified == false &&
                       incoming().accountStatus == 'active' &&
                       incoming().followersCount == 0 &&
                       incoming().followingCount == 0 &&
                       incoming().totalViews == 0 &&
                       incoming().totalVideos == 0 &&
                       incoming().totalWatchTimeSec == 0 &&
                       incoming().keys().hasAll([
                         'creatorId', 'displayName', 'username', 'bio', 'avatarUrl',
                         'coverUrl', 'socialLink', 'verified', 'accountStatus',
                         'followersCount', 'followingCount', 'totalViews', 'totalVideos',
                         'totalWatchTimeSec', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'creatorId', 'displayName', 'username', 'bio', 'avatarUrl',
                         'coverUrl', 'socialLink', 'verified', 'accountStatus',
                         'followersCount', 'followingCount', 'totalViews', 'totalVideos',
                         'totalWatchTimeSec', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidCreatorProfile(incoming());

      allow update: if isValidId(creatorId) && isSignedIn() && isValidCreatorProfile(incoming()) &&
                       incoming().creatorId == existing().creatorId &&
                       incoming().createdAt == existing().createdAt && (
        // Tier 1: Admin verification & moderation
        (
          isAdmin() &&
          incoming().diff(existing()).affectedKeys().hasOnly(['verified', 'accountStatus', 'updatedAt'])
        ) ||
        // Tier 2: Owner profile edit & own stats
        (
          isOwner(creatorId) &&
          incoming().verified == existing().verified &&
          incoming().accountStatus == existing().accountStatus &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'username', 'bio', 'avatarUrl', 'coverUrl',
            'socialLink', 'followingCount', 'totalVideos', 'updatedAt'
          ])
        ) ||
        // Tier 3: Peer follow/unfollow delta
        (
          incoming().verified == existing().verified &&
          incoming().accountStatus == existing().accountStatus &&
          (incoming().followersCount == existing().followersCount + 1 || incoming().followersCount == existing().followersCount - 1) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['followersCount', 'updatedAt'])
        ) ||
        // Tier 4: Peer video view/watchTime increment
        (
          incoming().verified == existing().verified &&
          incoming().accountStatus == existing().accountStatus &&
          incoming().totalViews >= existing().totalViews &&
          incoming().totalWatchTimeSec >= existing().totalWatchTimeSec &&
          incoming().diff(existing()).affectedKeys().hasOnly(['totalViews', 'totalWatchTimeSec', 'updatedAt'])
        )
      );

      allow delete: if isValidId(creatorId) && (isOwner(creatorId) || isAdmin());
    }

    // 3. Videos & Shorts
    match /videos/{videoId} {
      allow get: if isValidId(videoId) && isSignedIn() && (
        (existing().visibility in ['public', 'unlisted'] && existing().moderationStatus == 'approved') ||
        existing().creatorId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        (existing().visibility == 'public' && existing().moderationStatus == 'approved') ||
        existing().creatorId == request.auth.uid ||
        isAdmin()
      );

      allow create: if isValidId(videoId) &&
                       isSignedIn() &&
                       incoming().creatorId == request.auth.uid &&
                       incoming().featured == false &&
                       incoming().trendingPinned == false &&
                       incoming().moderationStatus == 'approved' &&
                       incoming().viewsCount == 0 &&
                       incoming().likesCount == 0 &&
                       incoming().commentsCount == 0 &&
                       incoming().savesCount == 0 &&
                       incoming().watchTimeTotalSec == 0 &&
                       incoming().keys().hasAll([
                         'creatorId', 'creatorName', 'creatorUsername', 'creatorAvatarUrl',
                         'creatorVerified', 'title', 'description', 'videoUri', 'thumbnailUri',
                         'shortForm', 'featured', 'trendingPinned', 'category', 'tags',
                         'language', 'visibility', 'moderationStatus', 'processingStatus',
                         'durationSec', 'viewsCount', 'likesCount', 'commentsCount',
                         'savesCount', 'watchTimeTotalSec', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'creatorId', 'creatorName', 'creatorUsername', 'creatorAvatarUrl',
                         'creatorVerified', 'title', 'description', 'videoUri', 'thumbnailUri',
                         'shortForm', 'featured', 'trendingPinned', 'category', 'tags',
                         'language', 'visibility', 'moderationStatus', 'processingStatus',
                         'durationSec', 'viewsCount', 'likesCount', 'commentsCount',
                         'savesCount', 'watchTimeTotalSec', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidVideo(incoming());

      allow update: if isValidId(videoId) && isSignedIn() && isValidVideo(incoming()) &&
                       incoming().creatorId == existing().creatorId &&
                       incoming().createdAt == existing().createdAt && (
        // Tier 1: Admin moderation & featuring
        (
          isAdmin() &&
          incoming().diff(existing()).affectedKeys().hasOnly(['moderationStatus', 'featured', 'trendingPinned', 'updatedAt'])
        ) ||
        // Tier 2: Creator metadata edit
        (
          existing().creatorId == request.auth.uid &&
          incoming().moderationStatus == existing().moderationStatus &&
          incoming().featured == existing().featured &&
          incoming().trendingPinned == existing().trendingPinned &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'description', 'thumbnailUri', 'category', 'tags',
            'language', 'visibility', 'processingStatus', 'updatedAt'
          ])
        ) ||
        // Tier 3: Viewer engagement counters
        (
          incoming().moderationStatus == existing().moderationStatus &&
          incoming().featured == existing().featured &&
          incoming().trendingPinned == existing().trendingPinned &&
          incoming().viewsCount >= existing().viewsCount &&
          incoming().watchTimeTotalSec >= existing().watchTimeTotalSec &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'viewsCount', 'likesCount', 'commentsCount', 'savesCount', 'watchTimeTotalSec', 'updatedAt'
          ])
        )
      );

      allow delete: if isValidId(videoId) && isSignedIn() && (existing().creatorId == request.auth.uid || isAdmin());

      // Comments subcollection
      match /comments/{commentId} {
        allow get: if isValidId(videoId) && isValidId(commentId) && isSignedIn();
        allow list: if isValidId(videoId) && isSignedIn() && existing().videoId == videoId;

        allow create: if isValidId(videoId) && isValidId(commentId) && isSignedIn() &&
                         incoming().authorId == request.auth.uid &&
                         incoming().pinned == false &&
                         incoming().likesCount == 0 &&
                         incoming().keys().hasAll([
                           'videoId', 'authorId', 'authorName', 'authorAvatarUrl', 'text',
                           'parentCommentId', 'likesCount', 'pinned', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'videoId', 'authorId', 'authorName', 'authorAvatarUrl', 'text',
                           'parentCommentId', 'likesCount', 'pinned', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidComment(incoming(), videoId) &&
                         exists(/databases/$(database)/documents/videos/$(videoId));

        allow update: if isValidId(videoId) && isValidId(commentId) && isSignedIn() &&
                         isValidComment(incoming(), videoId) &&
                         incoming().videoId == existing().videoId &&
                         incoming().authorId == existing().authorId &&
                         incoming().createdAt == existing().createdAt && (
          isAdmin() ||
          (
            existing().authorId == request.auth.uid &&
            incoming().pinned == existing().pinned &&
            incoming().diff(existing()).affectedKeys().hasOnly(['text', 'updatedAt'])
          ) ||
          (
            get(/databases/$(database)/documents/videos/$(videoId)).data.creatorId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['pinned', 'updatedAt'])
          ) ||
          (
            incoming().pinned == existing().pinned &&
            incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt'])
          )
        );

        allow delete: if isValidId(videoId) && isValidId(commentId) && isSignedIn() && (
          existing().authorId == request.auth.uid ||
          get(/databases/$(database)/documents/videos/$(videoId)).data.creatorId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // 4. Moderation Reports
    match /reports/{reportId} {
      allow get: if isValidId(reportId) && isSignedIn() && (existing().reporterId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().reporterId == request.auth.uid || isAdmin());

      allow create: if isValidId(reportId) && isSignedIn() &&
                       incoming().reporterId == request.auth.uid &&
                       incoming().status == 'open' &&
                       incoming().keys().hasAll([
                         'reporterId', 'targetType', 'targetId', 'targetVideoId',
                         'reason', 'details', 'status', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'reporterId', 'targetType', 'targetId', 'targetVideoId',
                         'reason', 'details', 'status', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidReport(incoming());

      allow update: if isValidId(reportId) && isAdmin() &&
                       isValidReport(incoming()) &&
                       incoming().reporterId == existing().reporterId &&
                       incoming().createdAt == existing().createdAt &&
                       existing().status != 'resolved' &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if isValidId(reportId) && isAdmin();
    }

    // 5. Platform Settings (Admin-controlled categories & notices)
    match /platformSettings/{settingId} {
      allow get: if isValidId(settingId) && isSignedIn();
      allow list: if isSignedIn() && existing().featuredBannerText is string;
      allow create, update: if isValidId(settingId) && isAdmin() &&
                               incoming().keys().hasAll(['disabledCategories', 'featuredBannerText', 'maintenanceNotice', 'updatedAt']) &&
                               incoming().keys().hasOnly(['disabledCategories', 'featuredBannerText', 'maintenanceNotice', 'updatedAt']) &&
                               isBoundedStringList(incoming().disabledCategories, 30) &&
                               incoming().featuredBannerText is string && incoming().featuredBannerText.size() <= 200 &&
                               incoming().maintenanceNotice is string && incoming().maintenanceNotice.size() <= 300 &&
                               isValidTimestamp(incoming().updatedAt);
      allow delete: if isValidId(settingId) && isAdmin();
    }

    // 6. Admins Registry
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isValidId(adminUid) && isAdmin();
    }
  }
}
